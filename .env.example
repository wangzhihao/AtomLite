# ---- 服务 ----
# 会话 Cookie 的签名密钥（线上用 openssl rand -hex 32 生成）
AUTH_SECRET=change-me
# 数据目录：账号、项目、版本、对话、runs 都存在这里的 db.json
ATOMS_DATA_DIR=.data
# 通过 http 访问（尚未配置 HTTPS）时设为 1，否则浏览器不接受 Secure Cookie
ATOMS_INSECURE_COOKIE=

# ---- LLM ----
# 配置后使用 Claude；留空则使用确定性的 Mock LLM（演示 / 测试用）
ANTHROPIC_API_KEY=
ATOMS_STRONG_MODEL=claude-opus-5-5
# 规划、设计、建议等轻量角色使用的快速模型
ATOMS_FAST_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
ATOMS_EFFORT=medium
# 每百万 token 单价（美元），用于成本统计
ATOMS_PRICE_IN=4
ATOMS_PRICE_OUT=20
ATOMS_PRICE_CACHE_READ=0.2
ATOMS_FAST_PRICE_IN=0.1
ATOMS_FAST_PRICE_OUT=0.5
ATOMS_FAST_PRICE_CACHE_READ=0.01

# 模型额度用完时提示用户联系充值的邮箱
ATOMS_SUPPORT_EMAIL=accept.acm@gmail.com
