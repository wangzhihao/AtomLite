# ---- 鉴权与存储 ----
# 配置后使用 Supabase（Auth + Postgres + RLS）；留空则使用本地文件存储（仅开发 / 测试）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端使用：发布页与 Remix 读取他人已发布的版本
SUPABASE_SERVICE_ROLE_KEY=
# 本地模式会话签名密钥
AUTH_SECRET=change-me
# 本地模式数据目录
ATOMS_DATA_DIR=.data

# ---- LLM ----
# 配置后使用 Claude；留空则使用确定性的 Mock LLM（演示 / 测试用）
ANTHROPIC_API_KEY=
ATOMS_STRONG_MODEL=claude-opus-5-5
# 规划、设计、建议等轻量角色使用的快速模型
ATOMS_FAST_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
ATOMS_EFFORT=medium
# 每百万 token 单价（美元），用于成本统计
ATOMS_PRICE_IN=4
ATOMS_PRICE_OUT=20
ATOMS_PRICE_CACHE_READ=0.2
ATOMS_FAST_PRICE_IN=0.1
ATOMS_FAST_PRICE_OUT=0.5
ATOMS_FAST_PRICE_CACHE_READ=0.01
